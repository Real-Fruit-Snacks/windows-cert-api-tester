<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net9.0-windows + UseWPF so the tests can reference the WPF app assembly and cover
         its request-model mapping logic (RequestModel / CollectionNode). -->
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test-only: an in-process Kestrel + Grpc.AspNetCore server (Phase D5 of the spec) so
         GrpcCaller (later slices) and the harness itself (this slice) can be exercised against a
         real gRPC/HTTP2 server rather than a stand-in. Pinned to the same version as
         ApiTester.Grpc's Grpc.Net.Client/Grpc.Reflection, and Google.Protobuf pinned to the same
         version everywhere it appears, so no NU1605 downgrade warning trips -warnaserror. -->
    <PackageReference Include="Grpc.AspNetCore" Version="2.80.0" />
    <PackageReference Include="Grpc.AspNetCore.Server.Reflection" Version="2.80.0" />
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ApiTester.Core\ApiTester.Core.csproj" />
    <ProjectReference Include="..\..\src\ApiTester.App\ApiTester.App.csproj" />
    <ProjectReference Include="..\..\src\ApiTester.Cli\ApiTester.Cli.csproj" />
    <ProjectReference Include="..\..\src\ApiTester.Grpc\ApiTester.Grpc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- GrpcServices="Both": tests need the client stub (to prove the harness works, and later to
         drive JSON<->Protobuf differential tests) and the server stub (to implement EchoService). -->
    <Protobuf Include="Grpc\certapi_test.proto" GrpcServices="Both" />
  </ItemGroup>

</Project>
