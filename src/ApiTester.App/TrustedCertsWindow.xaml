<Window x:Class="ApiTester.App.TrustedCertsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trusted certificates" Height="440" Width="640"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Bg.Window}" Foreground="{DynamicResource Text.Soft}"
        FontFamily="{StaticResource Mono}" FontSize="12.5"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Border BorderBrush="{DynamicResource Border.Strong}" BorderThickness="1">
        <DockPanel>
            <Border DockPanel.Dock="Top" Height="40" Background="{DynamicResource Bg.Panel}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" MouseLeftButtonDown="Header_Drag">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <TextBlock Text="&#x276F;" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource Accent}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="TRUSTED CERTIFICATES" FontWeight="Bold" FontSize="12" Margin="9,0,0,0"
                                   Foreground="{DynamicResource Text.Normal}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button Content="&#xE8BB;" HorizontalAlignment="Right" Style="{StaticResource CaptionClose}"
                            Height="40" Click="Close_Click"/>
                </Grid>
            </Border>

            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                        Margin="12,0,12,12">
                <Button Content="Remove" Height="26" FontSize="11" Padding="9,0" Click="Remove_Click"/>
                <Button Content="Close" Height="26" FontSize="11" Padding="9,0" Margin="6,0,0,0" Click="Close_Click"/>
            </StackPanel>

            <Grid Margin="12">
                <TextBlock x:Name="EmptyHint" Foreground="{DynamicResource Text.Faint}"
                           FontSize="11" TextWrapping="Wrap" Margin="4,20,4,0"
                           Text="No certificates are pinned yet. When a server presents an untrusted certificate, trusting it from the send error adds a pin here."/>
                <Border x:Name="ListBorder" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ListBox x:Name="CertsList" Margin="2" BorderThickness="0" Background="Transparent">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="8,7,8,7">
                                        <TextBlock Text="{Binding Host}" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Text.Normal}"/>
                                        <TextBlock Text="{Binding Thumbprint}" FontSize="11" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource Text.Soft}"/>
                                        <TextBlock Text="{Binding Subject}" FontSize="11" Margin="0,2,0,0"
                                                   TextWrapping="Wrap" Foreground="{DynamicResource Text.Faint}"/>
                                        <TextBlock FontSize="10" Margin="0,4,0,0" Foreground="{DynamicResource Text.Faint}">
                                            <TextBlock.Text>
                                                <Binding Path="AddedUtc" StringFormat="Trusted {0:yyyy-MM-dd}"/>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
