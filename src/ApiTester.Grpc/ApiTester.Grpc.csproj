<Project Sdk="Microsoft.NET.Sdk">

  <!-- This is the one project in the solution that takes a Protobuf/gRPC dependency. Keeping it
       isolated here means ApiTester.Core and ApiTester.App stay package-free, and only the
       `certapi grpc` command (via ApiTester.Cli's project reference to this assembly) ever loads
       Grpc.Net.Client / Grpc.Reflection / Google.Protobuf. See Phase D2 of the spec for why the
       no-new-dependencies rule bends here and nowhere else. -->

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ApiTester.Grpc</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApiTester.Core\ApiTester.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ApiTester.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned, not floating, like every other dependency in this repo. Grpc.Net.Client and
         Grpc.Reflection must stay on the same version as the test project's Grpc.AspNetCore /
         Grpc.AspNetCore.Server.Reflection, and Google.Protobuf must match everywhere it appears,
         or a NU1605 downgrade warning trips -warnaserror in CI. -->
    <PackageReference Include="Grpc.Net.Client" Version="2.80.0" />
    <PackageReference Include="Grpc.Reflection" Version="2.80.0" />
    <PackageReference Include="Google.Protobuf" Version="3.35.1" />
  </ItemGroup>

</Project>
